---
import { getCollection } from "astro:content";

const products = await getCollection("products");
---

<!doctype html>
<html lang="en">

<head>

  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />

  <title>Invenco Solder | Electrical & Soldering Supplies</title>

  <meta
    name="description"
    content="Invenco Solder - quality solder wire and electrical soldering supplies."
  />

  <style>

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      background: #101214;
      color: #f5f5f5;
      font-family: Arial, Helvetica, sans-serif;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .container {
      width: min(1150px, calc(100% - 40px));
      margin: auto;
    }

    header {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      border-bottom: 1px solid rgba(255,255,255,.1);
      z-index: 10;
    }

    nav {
      height: 80px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 10px;
      font-weight: 800;
      font-size: 20px;
    }

    .logo-box {
      width: 38px;
      height: 38px;
      display: grid;
      place-items: center;
      background: #ff6a21;
      color: #111;
      font-weight: 900;
    }

    .logo small {
      display: block;
      color: #ff6a21;
      font-size: 8px;
      letter-spacing: 3px;
    }

    .nav-links {
      display: flex;
      gap: 30px;
      color: #aaa;
      font-size: 13px;
    }

    .nav-links a:hover {
      color: #ff6a21;
    }

    .hero {
      min-height: 720px;
      padding-top: 80px;
      display: flex;
      align-items: center;

      background:
        radial-gradient(
          circle at 75% 50%,
          rgba(255,106,33,.16),
          transparent 30%
        ),
        #101214;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 60px;
      align-items: center;
    }

    .eyebrow {
      color: #ff6a21;
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 3px;
    }

    h1 {
      margin: 20px 0;
      font-size: clamp(55px, 7vw, 95px);
      line-height: .86;
      text-transform: uppercase;
      letter-spacing: -3px;
    }

    h1 span,
    h2 span {
      color: #ff6a21;
    }

    .hero p {
      max-width: 500px;
      color: #92979a;
      line-height: 1.8;
      font-size: 15px;
    }

    .buttons {
      display: flex;
      gap: 12px;
      margin-top: 30px;
    }

    .button {
      padding: 16px 24px;
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 1px;
      text-transform: uppercase;
    }

    .primary {
      background: #ff6a21;
      color: #111;
    }

    .secondary {
      border: 1px solid #444;
    }

    .secondary:hover {
      border-color: #ff6a21;
      color: #ff6a21;
    }

    .hero-product {
      height: 430px;
      border: 1px solid #333;

      background:
        linear-gradient(
          135deg,
          #1d2124,
          #0c0e10
        );

      display: grid;
      place-items: center;
      position: relative;
      overflow: hidden;
    }

    .hero-product::before {
      content: "";
      width: 280px;
      height: 280px;
      border: 35px solid #999;
      border-radius: 50%;

      box-shadow:
        0 0 70px rgba(255,106,33,.15);
    }

    section {
      padding: 100px 0;
    }

    .section-title {
      margin-bottom: 45px;
    }

    .section-title small {
      color: #ff6a21;
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 3px;
    }

    h2 {
      margin: 12px 0 0;
      font-size: clamp(42px, 6vw, 70px);
      line-height: .9;
      text-transform: uppercase;
    }

    #shop {
      background: #0b0d0f;
      border-top: 1px solid #292d30;
      border-bottom: 1px solid #292d30;
    }

    .products {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 15px;
    }

    .product {
      display: block;
      background: #151719;
      border: 1px solid #292d30;
      transition: .25s;
      overflow: hidden;
    }

    .product:hover {
      transform: translateY(-5px);
      border-color: #ff6a21;
    }

    .product-image {
      height: 260px;
      background: #1b1e20;

      display: flex;
      align-items: center;
      justify-content: center;

      overflow: hidden;
    }

    .product-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: .3s;
    }

    .product:hover img {
      transform: scale(1.04);
    }

    .product-info {
      padding: 20px;
    }

    .product h3 {
      margin: 0;
      font-size: 18px;
      line-height: 1.2;
    }

    .product p {
      color: #777;
      font-size: 12px;
      line-height: 1.6;
      min-height: 58px;
    }

    .product-bottom {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
      border-top: 1px solid #292d30;
      padding-top: 15px;
    }

    .price {
      font-size: 20px;
      font-weight: 800;
      color: #ff6a21;
    }

    .view-product {
      padding: 10px 14px;
      background: #ff6a21;
      color: #111;
      font-size: 9px;
      font-weight: 800;
      letter-spacing: 1px;
      white-space: nowrap;
    }

    .categories {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 15px;
    }

    .category {
      min-height: 250px;
      padding: 30px;
      background: #151719;
      border: 1px solid #292d30;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      transition: .25s;
    }

    .category:hover {
      border-color: #ff6a21;
    }

    .category span {
      color: #ff6a21;
      font-size: 10px;
      letter-spacing: 2px;
    }

    .category h3 {
      margin: 10px 0;
      font-size: 30px;
    }

    .category p {
      color: #777;
      font-size: 12px;
      line-height: 1.6;
    }

    .about {
      background: #151719;
    }

    .about-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 70px;
      align-items: center;
    }

    .about-image {
      min-height: 450px;
      border: 1px solid #333;

      background:
        repeating-linear-gradient(
          45deg,
          #1c2022,
          #1c2022 10px,
          #171a1c 10px,
          #171a1c 20px
        );

      display: grid;
      place-items: center;
    }

    .about-image strong {
      color: #ff6a21;
      font-size: 80px;
    }

    .about-text p {
      color: #888;
      line-height: 1.8;
      font-size: 14px;
    }

    footer {
      padding: 60px 0 25px;
      background: #08090a;
    }

    .footer-grid {
      display: grid;
      grid-template-columns: 2fr 1fr 1fr;
      gap: 50px;
    }

    footer h3 {
      color: #ff6a21;
      font-size: 12px;
      letter-spacing: 2px;
    }

    footer p,
    footer a {
      color: #666;
      font-size: 12px;
      line-height: 2;
    }

    .copyright {
      margin-top: 50px;
      padding-top: 20px;
      border-top: 1px solid #222;
      color: #555;
      font-size: 10px;
    }

    @media (max-width: 850px) {

      .nav-links {
        display: none;
      }

      .hero-grid,
      .about-grid {
        grid-template-columns: 1fr;
      }

      .hero {
        padding: 130px 0 80px;
      }

      .hero-product {
        height: 350px;
      }

      .products {
        grid-template-columns: repeat(2, 1fr);
      }

      .categories {
        grid-template-columns: 1fr;
      }

      .footer-grid {
        grid-template-columns: 1fr;
      }

    }

    @media (max-width: 550px) {

      .container {
        width: calc(100% - 28px);
      }

      .products {
        grid-template-columns: 1fr;
      }

      .buttons {
        flex-direction: column;
      }

      .button {
        text-align: center;
      }

      h1 {
        font-size: 56px;
      }

    }

  </style>

</head>


<body>


<header>

  <div class="container">

    <nav>

      <a href="/" class="logo">

        <span class="logo-box">
          IS
        </span>

        <span>
          INVENCO
          <small>SOLDER</small>
        </span>

      </a>


      <div class="nav-links">

        <a href="/">
          Home
        </a>

        <a href="#shop">
          Shop
        </a>

        <a href="#categories">
          Categories
        </a>

        <a href="#about">
          About
        </a>

        <a href="#contact">
          Contact
        </a>

      </div>

    </nav>

  </div>

</header>


<main>


  <!-- HERO -->

  <section class="hero">

    <div class="container hero-grid">

      <div>

        <div class="eyebrow">
          PROFESSIONAL SOLDERING SUPPLIES
        </div>


        <h1>

          SOLDERING

          <br />

          <span>
            BUILT FOR THE JOB.
          </span>

        </h1>


        <p>

          Quality solder and electrical supplies
          for professionals, engineers, workshops,
          makers and repair specialists.

        </p>


        <div class="buttons">

          <a
            href="#shop"
            class="button primary"
          >
            Shop Products →
          </a>


          <a
            href="#categories"
            class="button secondary"
          >
            Explore Categories
          </a>

        </div>

      </div>


      <div class="hero-product"></div>

    </div>

  </section>



  <!-- SHOP -->

  <section id="shop">

    <div class="container">


      <div class="section-title">

        <small>
          01 / SHOP
        </small>

        <h2>

          FEATURED

          <br />

          <span>
            PRODUCTS.
          </span>

        </h2>

      </div>


      <div class="products">

        {
          products.map((product) => (

            <a
              href={`/product/${product.data.slug}`}
              class="product"
            >

              <div class="product-image">

                <img
                  src={product.data.image}
                  alt={product.name}
                />

              </div>


              <div class="product-info">

                <h3>
                  product.data.name
                </h3>


                <p>
                  product.data.description
                </p>


                <div class="product-bottom">

                  <span class="price">

                    From £{product.data.price.toFixed(2)}

                  </span>


                  <span class="view-product">
                    VIEW PRODUCT →
                  </span>

                </div>

              </div>

            </a>

          ))
        }

      </div>

    </div>

  </section>



  <!-- CATEGORIES -->

  <section id="categories">

    <div class="container">


      <div class="section-title">

        <small>
          02 / CATEGORIES
        </small>

        <h2>

          EVERYTHING FOR

          <br />

          <span>
            THE WORKBENCH.
          </span>

        </h2>

      </div>


      <div class="categories">


        <a
          href="#shop"
          class="category"
        >

          <span>
            01
          </span>

          <h3>
            Solder Wire
          </h3>

          <p>
            Professional solder wire
            for electrical and electronic work.
          </p>

        </a>


        <a
          href="#shop"
          class="category"
        >

          <span>
            02
          </span>

          <h3>
            Tin / Lead
          </h3>

          <p>
            Reliable tin and lead solder
            products for soldering applications.
          </p>

        </a>


        <a
          href="#shop"
          class="category"
        >

          <span>
            03
          </span>

          <h3>
            Accessories
          </h3>

          <p>
            Flux and other essential
            soldering and electrical supplies.
          </p>

        </a>


      </div>

    </div>

  </section>



  <!-- ABOUT -->

  <section
    id="about"
    class="about"
  >

    <div class="container about-grid">


      <div class="about-image">

        <strong>
          IS
        </strong>

      </div>


      <div class="about-text">


        <div class="section-title">

          <small>
            03 / ABOUT INVENCO
          </small>

          <h2>

            QUALITY

            <br />

            <span>
              MATTERS.
            </span>

          </h2>

        </div>


        <p>

          Invenco Solder supplies soldering
          and electrical products designed
          for reliable everyday use.

        </p>


        <p>

          From professional workshops to
          electronics benches and repair stations,
          we're focused on providing dependable
          products and straightforward service.

        </p>


      </div>


    </div>

  </section>



  <!-- CONTACT -->

  <section id="contact">

    <div class="container">


      <div class="section-title">

        <small>
          04 / CONTACT
        </small>

        <h2>

          NEED

          <br />

          <span>
            HELP?
          </span>

        </h2>

      </div>


      <p
        style="
          color:#888;
          max-width:500px;
          line-height:1.8;
        "
      >

        Have a question about a product
        or an order? Get in touch with
        the Invenco Solder team.

      </p>


      <a
        href="mailto:info@invencosolder.co.uk"
        class="button primary"
        style="
          display:inline-block;
          margin-top:20px;
        "
      >

        Email Us →

      </a>


    </div>

  </section>


</main>



<!-- FOOTER -->

<footer>

  <div class="container">


    <div class="footer-grid">


      <div>

        <div class="logo">

          <span class="logo-box">
            IS
          </span>

          <span>
            INVENCO
            <small>SOLDER</small>
          </span>

        </div>


        <p>
          Professional soldering and
          electrical supplies.
        </p>

      </div>


      <div>

        <h3>
          SHOP
        </h3>

        <a href="#shop">
          Products
        </a>

        <br />

        <a href="#categories">
          Categories
        </a>

      </div>


      <div>

        <h3>
          COMPANY
        </h3>

        <a href="#about">
          About
        </a>

        <br />

        <a href="#contact">
          Contact
        </a>

      </div>


    </div>


    <div class="copyright">

      © {new Date().getFullYear()}
      Invenco Solder.
      All rights reserved.

    </div>


  </div>

</footer>


</body>

</html>
